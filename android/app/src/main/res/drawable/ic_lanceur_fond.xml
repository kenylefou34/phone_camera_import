<?xml version="1.0" encoding="utf-8"?>
<!--
    Couche de FOND de l'icone adaptative.

    Un degrade chaud plutot qu'un aplat : l'application sert a ranger des
    photos de famille, pas a administrer un serveur. La diagonale monte vers
    la droite, dans le meme sens que la fleche de la couche avant.

    Tout en vectoriel, aucun PNG : minSdk vaut 29, donc les icones adaptatives
    sont disponibles partout et il n'y a aucune densite a decliner.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="108"
                android:endX="108"
                android:endY="0"
                android:type="linear">
                <item android:offset="0" android:color="#FFD96B4A" />
                <item android:offset="0.55" android:color="#FFF08A4B" />
                <item android:offset="1" android:color="#FFFFC46B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
