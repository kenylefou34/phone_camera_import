<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Sans cette déclaration, Android 14+ fait tourner l'appli en « mode de
         compatibilité » : une sélection partielle de photos y accorde quand
         même READ_MEDIA_IMAGES/VIDEO pour la durée de la session, et
         Depot.accesPartiel() ne verrait alors JAMAIS l'accès partiel — le
         mode de panne silencieux exact que cette fonction existe pour
         signaler. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        android:minSdkVersion="34" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Non requise formellement par NsdManager, qui delegue le socket
         multicast au service systeme. Ajoutee par prudence : elle ameliore la
         fiabilite de la decouverte mDNS sur certaines ROMs constructeur, et un
         echec de decouverte est SILENCIEUX par conception (« serveur
         introuvable » ne declenche aucune alerte). Permission normale, sans
         invite a l'execution. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Sans ce service, la synchro vit dans le viewModelScope de l'activite :
         ecran eteint, Android la tue, aucun commit n'est emis et les Go deja
         montes restent dans le depot temporaire du NUC sans etre ranges.
         Constate le 21/09/2026. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ : sans elle, la notification d'avancement n'apparait pas,
         et l'utilisateur n'a plus AUCUN moyen de voir ou d'arreter une synchro
         qui tourne ecran eteint. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- allowBackup="false" : la sauvegarde Android copierait le fichier des
         préférences chiffrées, mais PAS la clé, qui vit dans le Keystore et ne
         quitte jamais l'appareil. Après restauration sur un nouveau téléphone,
         EncryptedSharedPreferences ne saurait plus déchiffrer. Le jeton
         d'appairage n'a de toute façon aucun sens sur un autre appareil : il
         faut rescanner un QR. -->
    <application android:label="Photothèque" android:allowBackup="false"
                 android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Le bouton « Interrompre » de la notification : un recepteur, pas
             une activite, pour pouvoir arreter SANS rouvrir l'application. -->
        <receiver android:name=".synchro.RecepteurInterruption" android:exported="false" />

        <!-- WorkManager declare son propre service de premier plan, mais SANS
             foregroundServiceType. Or ForegroundInfo lui passe DATA_SYNC, et
             depuis Android 10 la plate-forme refuse un type qui n'est pas un
             sous-ensemble de celui du manifeste — IllegalArgumentException
             non rattrapee, donc plantage a la premiere synchro. On fusionne
             l'attribut manquant. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
